ARG BASE_IMAGE=registry.fly.io/ytsearch-raw-production:split-gate-c1f66fa

FROM denoland/deno:bin-2.8.1 AS deno
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg python3-pip \
    && python3 -m pip install --no-cache-dir --break-system-packages --upgrade 'yt-dlp[default]' \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deno /deno /usr/local/bin/deno
COPY ytsearch /usr/local/bin/ytsearch
COPY cloud-index-queue /usr/local/bin/cloud-index-queue
RUN chmod 0755 /usr/local/bin/cloud-index-queue

ENTRYPOINT []
CMD ["/bin/sh", "/usr/local/bin/cloud-index-queue"]
