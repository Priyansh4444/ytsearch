FROM rust:1-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --locked --release -p youtube_raw_search

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 rawsearch
COPY --from=builder /app/target/release/youtube-raw-search /usr/local/bin/youtube-raw-search
COPY --chown=rawsearch:rawsearch .search-experiment/raw-index /data/index
USER rawsearch
ENV RAW_SEARCH_BIND=0.0.0.0:8108
ENV RAW_SEARCH_INDEX_PATH=/data/index
EXPOSE 8108
CMD ["youtube-raw-search", "serve"]
