{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ytsearch-search-experimental",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "search.experimental.pronsh.dev", "custom_domain": true }],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://search.experimental.pronsh.dev",
    "API_BASE_URL": "https://ytsearch-api-raw-experiment.fly.dev",
    "INDEX_QUEUE_API_BASE_URL": "https://ytsearch-api-typesense-fly-staging.fly.dev",
    "FLY_API_BASE_URL": "https://api.machines.dev",
    "FLY_APP_NAME": "ytsearch-indexer-staging",
    "FLY_TYPESENSE_APP_NAME": "ytsearch-typesense-staging",
    "FLY_TYPESENSE_MACHINE_ID": "8147deb94937e8",
    "TYPESENSE_HEALTH_URL": "https://ytsearch-raw-experiment.fly.dev/health",
    "SEARCH_SCHEDULE_MODE": "bypass",
  },
  "queues": {
    "producers": [{ "binding": "INDEX_WAKE_QUEUE", "queue": "ytsearch-indexer-wake" }],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
