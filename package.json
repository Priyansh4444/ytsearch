{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "frontend:check": "bun run typecheck && bun run format:check && bun run lint && bun run build",
    "deploy:frontend": "scripts/cloudflare-pages-deploy.sh",
    "hooks:install": "scripts/install-git-hooks.sh",
    "serve": "vite preview",
    "api": "cargo run --release -p youtube_api",
    "lint": "oxlint .",
    "format": "oxfmt --write package.json index.html src .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check package.json index.html src .oxfmtrc.json .oxlintrc.json"
  },
  "dependencies": {
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "autoprefixer": "^10.4.22",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "postcss": "^8.5.6",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.107.0"
  }
}
