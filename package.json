{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:rust && bun run test:frontend",
    "test:rust": "cargo test --workspace",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:frontend:coverage": "vitest run --coverage",
    "check:all": "scripts/check-all.sh",
    "frontend:check": "bun run typecheck && bun run format:check && bun run lint && bun run build",
    "deploy:frontend": "scripts/cloudflare-pages-deploy.sh",
    "hooks:install": "scripts/install-git-hooks.sh",
    "serve": "vite preview",
    "api": "cargo run --release -p youtube_api",
    "lint": "oxlint .",
    "format": "oxfmt --write package.json index.html src .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check package.json index.html src .oxfmtrc.json .oxlintrc.json"
  },
  "dependencies": {
    "lucide-solid": "^1.24.0",
    "posthog-js": "^1.399.2",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.22",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "postcss": "^8.5.6",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
