#!/usr/bin/env sh
set -eu

if [ "${YTSEARCH_SKIP_DEPLOY_ON_COMMIT:-}" = "1" ]; then
  echo "Skipping Cloudflare Pages deploy because YTSEARCH_SKIP_DEPLOY_ON_COMMIT=1"
  exit 0
fi

# Keep a single public Pages surface. Preview branch aliases such as
# master.ytsearch-755.pages.dev are intentionally not published from commits.
CLOUDFLARE_PAGES_BRANCH=main scripts/cloudflare-pages-deploy.sh main
