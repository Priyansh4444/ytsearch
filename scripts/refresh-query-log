#!/usr/bin/env sh
set -eu

# Append newly recorded Axiom search queries to query-log.txt.
# The existing log may contain legacy query-only lines; new entries use:
#   [<RFC3339 time>]: <query>
#
# Axiom's tabular APL response is column-oriented:
#   tables[].fields[i].name  <->  tables[].columns[i][row]
# and the scan window is controlled by request startTime/endTime.

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
. "$SCRIPT_DIR/axiom-query-lib.sh"

AXIOM_DATASET="${AXIOM_DATASET:-ytsearch}"
log_file="${QUERY_LOG_FILE:-$ROOT_DIR/query-log.txt}"
initial_window="${QUERY_LOG_INITIAL_WINDOW:-365d}"
limit="${QUERY_LOG_LIMIT:-65000}"

axiom_require_query_config
command -v curl >/dev/null 2>&1 || { echo "curl is required." >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "jq is required." >&2; exit 1; }
axiom_validate_duration QUERY_LOG_INITIAL_WINDOW "$initial_window"
case "$limit" in
  *[!0-9]* | "" | 0)
    echo "QUERY_LOG_LIMIT must be a positive integer." >&2
    exit 1
    ;;
esac

last_seen=""
if [ -f "$log_file" ]; then
  last_seen="$(axiom_last_logged_time "$log_file")"
fi

if [ -n "$last_seen" ]; then
  # Inclusive API window from the last written event; APL excludes that exact
  # timestamp so re-runs do not duplicate the boundary row.
  start_time="$last_seen"
  time_filter="where _time > datetime(\"${last_seen}\")"
else
  start_time="now-${initial_window}"
  time_filter="where true"
fi

apl="['${AXIOM_QUERY_DATASET}'] | ${time_filter} | where event == \"search_query\" | where isnotnull(query) and query != \"\" | project _time, query | sort by _time asc | limit ${limit}"

response="$(mktemp)"
trap 'rm -f "$response"' EXIT HUP INT TERM
axiom_query_to_file "$apl" "$start_time" "$response"

mkdir -p "$(dirname "$log_file")"
if [ ! -f "$log_file" ]; then
  printf '%s\n' \
    '# Search queries from Axiom' \
    '# Entries are [RFC3339 timestamp]: query' \
    '' >"$log_file"
fi

# Tabular format is column-oriented. Also accept legacy matches[] if present.
# Output lines: [time]: query
count="$(axiom_query_log_lines "$response" | tee -a "$log_file" | wc -l | tr -d ' ')"

if [ "$count" -eq 0 ]; then
  if [ -n "$last_seen" ]; then
    echo "No new search queries since $last_seen."
  else
    echo "No search queries in the last ${initial_window}."
  fi
else
  echo "Appended $count search quer$( [ "$count" -eq 1 ] && echo y || echo ies ) to $log_file (window start: $start_time)."
fi
