{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ytsearch-search",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "search.pronsh.dev", "custom_domain": true }],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://search.pronsh.dev",
    "API_BASE_URL": "https://ytsearch-api-raw-production.fly.dev",
    "INDEX_QUEUE_API_BASE_URL": "https://ytsearch-api-raw-production.fly.dev",
    "FLY_API_BASE_URL": "https://api.machines.dev",
    "FLY_APP_NAME": "ytsearch-indexer-raw-production",
    "FLY_RAW_SEARCH_APP_NAME": "ytsearch-raw-production",
    "FLY_RAW_SEARCH_MACHINE_ID": "d89303da029328",
    "RAW_SEARCH_HEALTH_URL": "https://ytsearch-raw-production.fly.dev/health",
    "SEARCH_SCHEDULE_MODE": "enforce",
  },
  "queues": {
    "producers": [{ "binding": "INDEX_WAKE_QUEUE", "queue": "ytsearch-indexer-wake" }],
    "consumers": [
      {
        "queue": "ytsearch-indexer-wake",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *", "17 */6 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
