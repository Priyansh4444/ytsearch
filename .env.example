YOUTUBE_API_KEY=

# Search backend.
YTSEARCH_SEARCH_BACKEND=raw
YTSEARCH_TRANSCRIPTS_INDEX=youtube_transcript_chunks

# Mutable Raw search client/indexing config.
RAW_SEARCH_API_URL=http://127.0.0.1:8108
RAW_SEARCH_ADMIN_API_KEY=
RAW_SEARCH_API_KEY=
RAW_SEARCH_COLLECTION=youtube_transcript_chunks

# Fly deploy/auth config.
FLYIO_TOKEN=
FLY_ORG=
FLY_REGION=sjc
RAW_SEARCH_APP_NAME=ytsearch-raw-production
YTSEARCH_INDEX_QUEUE_TOKEN=
INDEX_QUEUE_API_BASE_URL=http://127.0.0.1:8787

# API/frontend runtime.
YTSEARCH_API_ADDR=127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_INDEX_QUEUE_API_BASE_URL=http://127.0.0.1:8787
YTSEARCH_ALLOWED_ORIGINS=https://app.example.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_KOFI_URL=https://ko-fi.com/your-page
YTSEARCH_SEARCH_RATE_LIMIT_PER_MINUTE=120
YTSEARCH_INDEX_REQUEST_RATE_LIMIT_PER_MINUTE=6
YTSEARCH_INDEX_QUEUE_MAX_ITEMS=10000

# Optional Cloudflare Worker deployment.
CLOUDFLARE_API_TOKEN=

# Optional ingestion fallback.
YT_DLP_COOKIES_FILE=
YT_DLP_EXTRACTOR_ARGS=youtube:player_client=default,mweb
RUST_LOG=youtube_api=info,youtube_cli=info,youtube_sources=info,youtube_ytdlp=info,youtube_transcribe=info,tower_http=info
LOG_FORMAT=json
