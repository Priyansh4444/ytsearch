YOUTUBE_API_KEY=

# Search backend.
YTSEARCH_SEARCH_BACKEND=typesense
YTSEARCH_TRANSCRIPTS_INDEX=youtube_transcript_chunks

# Self-hosted Typesense client/indexing config.
TYPESENSE_API_URL=
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_SEARCH_API_KEY=
TYPESENSE_COLLECTION=youtube_transcript_chunks
TYPESENSE_SELFHOST_API_URL=http://127.0.0.1:8108
TYPESENSE_FLY_API_BASE_URL=
TYPESENSE_FLY_API_HOST=

# Fly deploy/auth config.
FLYIO_TOKEN=
FLY_ORG=
FLY_REGION=sjc
TYPESENSE_APP_NAME=
TYPESENSE_SELFHOST_API_KEY=
YTSEARCH_INDEX_QUEUE_TOKEN=
INDEX_QUEUE_API_BASE_URL=http://127.0.0.1:8787

# API/frontend runtime.
YTSEARCH_API_ADDR=127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_INDEX_QUEUE_API_BASE_URL=http://127.0.0.1:8787
YTSEARCH_ALLOWED_ORIGINS=https://search.pronsh.dev
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_KOFI_URL=https://ko-fi.com/your-page
YTSEARCH_SEARCH_RATE_LIMIT_PER_MINUTE=120

# Optional Cloudflare Pages deployment.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=ytsearch
CLOUDFLARE_PAGES_BRANCH=main

# Optional ingestion fallback.
YT_DLP_COOKIES_FILE=
YT_DLP_EXTRACTOR_ARGS=youtube:player_client=default,mweb
RUST_LOG=youtube_api=info,youtube_cli=info,youtube_sources=info,youtube_ytdlp=info,youtube_transcribe=info,tower_http=info
LOG_FORMAT=json
