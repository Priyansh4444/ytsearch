YOUTUBE_API_KEY=

# Default staging backend.
YTSEARCH_SEARCH_BACKEND=meilisearch
MEILI_HTTP_ADDR=https://ytsearch-meili-staging.fly.dev
MEILI_MASTER_KEY=
MEILI_SEARCH_API_KEY=
MEILI_TRANSCRIPTS_INDEX=youtube_transcript_chunks

# Typesense Cloud or self-hosted Typesense client/indexing config.
TYPESENSE_API_URL=
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_SEARCH_API_KEY=
TYPESENSE_COLLECTION=youtube_transcript_chunks
TYPESENSE_CLOUD_API_BASE_URL=https://ytsearch-api-pronsh-sandbox.fly.dev
TYPESENSE_SELFHOST_API_URL=https://ytsearch-typesense-staging.fly.dev
TYPESENSE_FLY_API_BASE_URL=https://ytsearch-api-typesense-fly-staging.fly.dev
MEILI_API_BASE_URL=https://ytsearch-api-meili-staging.fly.dev
MEILI_API_HOST=ytsearch-api-meili-staging.fly.dev
TYPESENSE_CLOUD_API_HOST=ytsearch-api-pronsh-sandbox.fly.dev
TYPESENSE_FLY_API_HOST=ytsearch-api-typesense-fly-staging.fly.dev

# Fly deploy/auth config.
FLYIO_TOKEN=
FLY_ORG=pronsh-sandbox
FLY_REGION=sjc
TYPESENSE_APP_NAME=ytsearch-typesense-staging
TYPESENSE_SELFHOST_API_KEY=
YTSEARCH_INDEX_QUEUE_TOKEN=
INDEX_QUEUE_API_BASE_URL=https://ytsearch-index-queue-staging.fly.dev

# API/frontend runtime.
YTSEARCH_API_ADDR=127.0.0.1:8787
VITE_API_BASE_URL=https://ytsearch-api-meili-staging.fly.dev
VITE_INDEX_QUEUE_API_BASE_URL=https://ytsearch-index-queue-staging.fly.dev
YTSEARCH_SEARCH_RATE_LIMIT_PER_MINUTE=120

# Optional ingestion fallback.
YT_DLP_COOKIES_FILE=
YT_DLP_EXTRACTOR_ARGS=youtube:player_client=default,mweb
RUST_LOG=youtube_api=info,youtube_cli=info,youtube_sources=info,youtube_ytdlp=info,youtube_transcribe=info,tower_http=info
LOG_FORMAT=json
