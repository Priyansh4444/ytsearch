ARG BASE_IMAGE=registry.fly.io/ytsearch-raw-production:query-intersection-47d7a71-r2

FROM rust:1.97-bookworm AS builder
ARG SOURCE_COMMIT
ENV YTSEARCH_SOURCE_COMMIT=${SOURCE_COMMIT}
WORKDIR /build
COPY .cargo ./.cargo
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --locked --release -p youtube_raw_search

FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
      io.ytsearch.base-image=${BASE_IMAGE}
RUN install -d -m 0755 /usr/local/share/ytsearch-release \
    && printf '%s\n' "$SOURCE_COMMIT" > /usr/local/share/ytsearch-release/source-commit \
    && printf '%s\n' "$BASE_IMAGE" > /usr/local/share/ytsearch-release/base-image

# Rust-only releases reuse the checksummed corpus/source layers from a fully
# built Raw image. Compile against the same Debian generation as the runtime so
# a developer workstation's newer glibc can never leak into production.
COPY --from=builder /build/target/release/youtube-raw-search /usr/local/bin/youtube-raw-search
RUN /usr/local/bin/youtube-raw-search --help >/dev/null
